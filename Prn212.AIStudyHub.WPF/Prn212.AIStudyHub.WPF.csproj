    <ProjectReference Include="..\src\PRN212.AIStudyHub.Infrastructure\PRN212.AIStudyHub.Infrastructure.csproj" />
    <ProjectReference Include="..\src\PRN212.AIStudyHub.WebAPI\PRN212.AIStudyHub.WebAPI.csproj" />
  </ItemGroup>

</Project>
